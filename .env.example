# ==========================================
# Bandera Asistencia - Variables de Entorno
# ==========================================

# Puerto del servidor HTTP
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Ruta de la base de datos SQLite
DATABASE_PATH=data.sqlite

# Secreto para firma criptográfica de tokens JWT de sesión (mínimo 32 caracteres en producción)
JWT_SECRET=bandera-asistencia-secret-key-2026-production

# Nombre de la cookie de sesión HTTP-only
SESSION_COOKIE_NAME=auth_session

# Duración de la sesión en segundos (28800 = 8 horas)
SESSION_MAX_AGE_SECONDS=28800

# Identificador de User-Agent para consultas de OpenStreetMap Nominatim
NOMINATIM_USER_AGENT=BanderaAsistencia/1.0 (asistencia@bandera.pe)

# Auto-sembrado de eventos de demostración al arrancar
AUTO_SEED=false
